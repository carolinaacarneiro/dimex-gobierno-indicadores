{
 "datasets": [
  {
   "name": "ds_decisiones",
   "displayName": "Decisiones de revisión",
   "queryLines": [
    "SELECT d.fecha_decision, d.revisor, h.tipo_hallazgo, h.id_ficha, h.id_ficha_relacionada, d.decision, d.id_ficha_oficial\n",
    "FROM decisiones_revision d JOIN hallazgos_revision h USING (id_hallazgo) ORDER BY d.fecha_decision DESC\n"
   ]
  },
  {
   "name": "ds_costos",
   "displayName": "Costo de la solución",
   "queryLines": [
    "SELECT usage_date, producto, sum(dbus) AS dbus, sum(costo_lista_usd) AS costo_lista_usd FROM costos_solucion GROUP BY ALL\n"
   ]
  },
  {
   "name": "ds_avisos",
   "displayName": "Avisos de publicación",
   "queryLines": [
    "SELECT fecha, notebook, tipo, objeto, detalle FROM avisos_publicacion ORDER BY fecha DESC\n"
   ]
  }
 ],
 "pages": [
  {
   "name": "p_auditoria",
   "displayName": "Auditoría",
   "pageType": "PAGE_TYPE_CANVAS",
   "layout": [
    {
     "widget": {
      "name": "tb3",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_decisiones",
         "fields": [
          {
           "name": "fecha_decision",
           "expression": "`fecha_decision`"
          },
          {
           "name": "revisor",
           "expression": "`revisor`"
          },
          {
           "name": "tipo_hallazgo",
           "expression": "`tipo_hallazgo`"
          },
          {
           "name": "id_ficha",
           "expression": "`id_ficha`"
          },
          {
           "name": "id_ficha_relacionada",
           "expression": "`id_ficha_relacionada`"
          },
          {
           "name": "decision",
           "expression": "`decision`"
          },
          {
           "name": "id_ficha_oficial",
           "expression": "`id_ficha_oficial`"
          }
         ],
         "disaggregated": true
        }
       }
      ],
      "spec": {
       "version": 1,
       "widgetType": "table",
       "encodings": {
        "columns": [
