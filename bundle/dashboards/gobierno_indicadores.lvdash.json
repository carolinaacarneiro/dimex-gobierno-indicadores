{
 "datasets": [
  {
   "name": "ds_kpis",
   "displayName": "Resumen del catálogo",
   "queryLines": [
    "SELECT count(*) AS fichas,\n",
    "       count_if(estado_certificacion = 'CERTIFICADO') AS certificados,\n",
    "       count_if(estado_certificacion = 'RETIRADO') AS unificadas,\n",
    "       count_if(estado_certificacion IN ('EN_REVISION', 'DEVUELTO_AL_AREA')) AS por_resolver,\n",
    "       (SELECT count(*) FROM hallazgos_revision WHERE estado = 'PENDIENTE') AS hallazgos_pendientes\n",
    "FROM catalogo_indicadores\n"
   ]
  },
  {
   "name": "ds_dominio",
   "displayName": "Fichas por dominio y estado",
   "queryLines": [
    "SELECT dominio, estado_certificacion, count(*) AS fichas FROM catalogo_indicadores GROUP BY ALL\n"
   ]
  },
  {
   "name": "ds_catalogo",
   "displayName": "Catálogo de indicadores",
   "queryLines": [
    "SELECT id_indicador, nombre, dominio, estado_certificacion, tipo_indicador, data_owner, meta_umbral,\n",
    "       array_join(sinonimos, ', ') AS sinonimos, vista_de_metricas, motivo_estado\n",
    "FROM catalogo_indicadores ORDER BY dominio, id_indicador\n"
   ]
  },
  {
   "name": "ds_hallazgos",
   "displayName": "Hallazgos por tipo y estado",
   "queryLines": [
    "SELECT tipo_hallazgo, estado, count(*) AS hallazgos FROM hallazgos_revision GROUP BY ALL\n"
   ]
  },
  {
   "name": "ds_pendientes",
   "displayName": "Hallazgos pendientes",
   "queryLines": [
    "SELECT prioridad, tipo_hallazgo, id_ficha, nombre, area, id_ficha_relacionada, nombre_relacionado, justificacion\n",
    "FROM hallazgos_revision WHERE estado = 'PENDIENTE'\n",
    "ORDER BY CASE prioridad WHEN 'Alta' THEN 1 WHEN 'Media' THEN 2 ELSE 3 END\n"
   ]
  },
  {
   "name": "ds_calidad",
   "displayName": "Última evaluación de calidad",
   "queryLines": [
    "SELECT r.id_indicador, c.nombre, r.tipo, r.descripcion, round(r.valor_obtenido_pct, 2) AS valor_pct, r.umbral_pct,\n",
    "       CASE WHEN r.cumple THEN 'Cumple' ELSE 'No cumple' END AS resultado, r.es_contingencia, r.fecha_evaluacion\n",
    "FROM resultados_calidad r JOIN catalogo_indicadores c USING (id_indicador)\n",
    "QUALIFY r.fecha_evaluacion = max(r.fecha_evaluacion) OVER (PARTITION BY r.id_indicador)\n",
    "ORDER BY r.id_indicador, r.tipo\n"
   ]
  },
  {
   "name": "ds_publicacion",
   "displayName": "Estado de publicación",
   "queryLines": [
    "SELECT p.id_indicador, c.nombre, CASE WHEN p.publicar THEN 'Publicar' ELSE 'En pausa' END AS estado, p.motivo_pausa, p.fecha_evaluacion\n",
    "FROM estado_publicacion_indicadores p JOIN catalogo_indicadores c USING (id_indicador)\n"
   ]
  },
  {
   "name": "ds_serie",
   "displayName": "Serie mensual de indicadores",
   "queryLines": [
    "SELECT id_indicador, concat(id_indicador, ' · ', nombre) AS indicador, mes, valor, meta_umbral FROM serie_mensual_indicadores WHERE mes < date_trunc('MONTH', current_date())\n"
   ]
  }
 ],
