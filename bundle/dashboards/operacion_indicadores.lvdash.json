          "fieldName": "decision",
          "displayName": "Decisión",
          "title": "Decisión"
         },
         {
          "fieldName": "id_ficha_oficial",
          "displayName": "Ficha oficial",
          "title": "Ficha oficial"
         }
        ]
       },
       "frame": {
        "showTitle": true,
