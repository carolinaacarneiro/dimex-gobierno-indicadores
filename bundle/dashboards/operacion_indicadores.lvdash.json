  {
   "name": "p_costos",
   "displayName": "Costos",
   "pageType": "PAGE_TYPE_CANVAS",
   "layout": [
    {
     "widget": {
      "name": "t2",
      "multilineTextboxSpec": {
       "lines": [
        "## Costo de la solución",
        "Consumo de la solución según `system.billing.usage` (etiquetas de los jobs y pipelines), valorizado a precio de lista. Los datos de facturación pueden tardar algunas horas."
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 2
     }
    },
    {
     "widget": {
      "name": "l2",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_costos",
         "fields": [
          {
           "name": "usage_date",
           "expression": "`usage_date`"
          },
          {
           "name": "costo_lista_usd",
           "expression": "SUM(`costo_lista_usd`)"
          },
          {
           "name": "producto",
           "expression": "`producto`"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 3,
       "widgetType": "line",
       "encodings": {
        "x": {
         "fieldName": "usage_date",
         "scale": {
          "type": "temporal"
         }
        },
        "y": {
         "fieldName": "costo_lista_usd",
         "scale": {
          "type": "quantitative"
         }
        },
        "color": {
         "fieldName": "producto",
         "scale": {
          "type": "categorical"
         }
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Costo diario a precio de lista (USD) por producto"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 2,
      "width": 6,
      "height": 6
     }
    },
    {
     "widget": {
      "name": "b3",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_costos",
         "fields": [
          {
           "name": "producto",
           "expression": "`producto`"
          },
          {
           "name": "dbus",
           "expression": "SUM(`dbus`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 3,
       "widgetType": "bar",
       "encodings": {
        "x": {
         "fieldName": "dbus",
         "scale": {
          "type": "quantitative"
         }
        },
        "y": {
         "fieldName": "producto",
         "scale": {
          "type": "categorical",
          "sort": {
           "by": "x-reversed"
          }
         }
        }
       },
       "frame": {
        "showTitle": true,
        "title": "DBU por producto (últimos 90 días)"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 8,
      "width": 6,
      "height": 5
     }
    }
   ]
  }
 ]
}